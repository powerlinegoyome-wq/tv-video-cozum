<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <!-- Üst Degrade Başlık Arka Planı (Ekran görüntüsündeki gibi #eb3349 -> #f45c43) -->
    <View
        android:id="@+id/bg_header"
        android:layout_width="match_parent"
        android:layout_height="190dp"
        android:background="@drawable/bg_header_gradient" />

    <!-- Ekranın Ortasındaki Ana Bölüm -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:paddingBottom="10dp">

        <!-- Üst Yayınevi Seçim Butonları (Altın Karma & Okyanus) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_tab_altinkarma"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/tab_button_selector"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="⭐ Altın Karma"
                android:textAllCaps="false"
                android:textColor="@color/tab_text_color"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_tab_okyanus"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/tab_button_selector"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="🌊 Okyanus (Akıllı Öğretim)"
                android:textAllCaps="false"
                android:textColor="@color/tab_text_color"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Üst Logo Rozeti (Altın Karma / Okyanus) -->
        <FrameLayout
            android:id="@+id/badge_container"
            android:layout_width="220dp"
            android:layout_height="68dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/card_white_rounded"
            android:elevation="6dp"
            android:padding="6dp">

            <LinearLayout
                android:id="@+id/badge_inner"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/badge_logo"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txt_badge_line1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:text="ALTIN KARMA"
                    android:textColor="#D4AF37"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txt_badge_line2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.12"
                    android:text="YAYINLARI"
                    android:textColor="#D4AF37"
                    android:textSize="11sp" />
            </LinearLayout>
        </FrameLayout>

        <!-- Beyaz Ana Kart -->
        <LinearLayout
            android:layout_width="740dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/card_white_rounded"
            android:elevation="8dp"
            android:orientation="vertical">

            <!-- ALTIN KARMA GÖRÜNÜMÜ -->
            <LinearLayout
                android:id="@+id/container_altinkarma"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- Üst Başlık & Geri Tuşu (Alt seviyelere inildiğinde görünür) -->
                <LinearLayout
                    android:id="@+id/layout_header_bar"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="16dp"
                    android:visibility="gone">

                    <ImageButton
                        android:id="@+id/btn_back"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:contentDescription="Geri Dön"
                        android:focusable="true"
                        android:src="@drawable/ic_arrow_back" />

                    <TextView
                        android:id="@+id/txt_header_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="#1F2937"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Arama Kutusu ("Yazmaya başla...") -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginEnd="12dp"
                        android:src="@drawable/ic_search" />

                    <EditText
                        android:id="@+id/edt_search"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:clickable="true"
                        android:focusable="false"
                        android:hint="Yazmaya başla..."
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:singleLine="true"
                        android:textColor="#374151"
                        android:textColorHint="#9CA3AF"
                        android:textSize="16sp" />
                </LinearLayout>

                <!-- İnce Çizgi -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E5E7EB" />

                <!-- Liste ve Yükleniyor Katmanı -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recycler_source_list"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:scrollbars="vertical" />

                    <ProgressBar
                        android:id="@+id/progress_loading"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center"
                        android:indeterminateTint="#F45C43"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>

            <!-- OKYANUS YAYINLARI GÖRÜNÜMÜ -->
            <LinearLayout
                android:id="@+id/container_okyanus"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Okyanus Video Çözüm &amp; Akıllı Öğretim"
                    android:textColor="#0284C7"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="Kitabınızdaki testin köşesindeki karekod numarasını girin veya portalı açın"
                    android:textColor="#64748B"
                    android:textSize="14sp" />

                <!-- Karekod Giriş Alanı -->
                <LinearLayout
                    android:layout_width="440dp"
                    android:layout_height="52dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/item_list_selector"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <EditText
                        android:id="@+id/edt_okyanus_code"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="Barkod No (Örn: 36457)"
                        android:imeOptions="actionGo"
                        android:inputType="number"
                        android:singleLine="true"
                        android:textColor="#0F172A"
                        android:textColorHint="#94A3B8"
                        android:textSize="17sp" />

                    <Button
                        android:id="@+id/btn_okyanus_go"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:background="@drawable/tab_button_selector"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="Aç"
                        android:textColor="#0284C7"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Portalı Aç Butonu -->
                <Button
                    android:id="@+id/btn_open_akilliogretim"
                    android:layout_width="440dp"
                    android:layout_height="48dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/item_list_selector"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="🌐 Akıllı Öğretim Web Portalını Aç"
                    android:textColor="#0284C7"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

        <!-- Alt Logo: FERNUS -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:letterSpacing="0.25"
            android:text="FERNUS"
            android:textColor="#F45C43"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

</RelativeLayout>
