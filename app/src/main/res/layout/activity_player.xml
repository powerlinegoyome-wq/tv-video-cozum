<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/player_root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- Ana TV Tarayıcı / Oynatıcı Katmanı -->
    <WebView
        android:id="@+id/webview_tv"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="true"
        android:focusableInTouchMode="true" />

    <!-- Tam Ekran Video Katmanı (HTML5 / Exo / WebChromeClient) -->
    <FrameLayout
        android:id="@+id/fullscreen_video_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        android:visibility="gone" />

    <!-- Yükleniyor Göstergesi -->
    <ProgressBar
        android:id="@+id/loading_indicator"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/focus_border" />

    <!-- TV Kumanda İpucu Şeridi (Geçici Bilgilendirme) -->
    <LinearLayout
        android:id="@+id/tv_hint_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="#D01E293B"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎮 Kumanda: Yön Tuşları = Gezinme | OK = Seç / Oynat | GERİ = Önceki Sayfa"
            android:textColor="@color/focus_border"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</FrameLayout>
